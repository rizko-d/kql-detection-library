// === MITRE ATT&CK ===
// Technique: T1110 — Brute Force
// Tactic: Credential Access
// Severity: High
// Data Source: SigninLogs, AADNonInteractiveUserSignInLogs
//
// Detects: Multiple failed RDP / remote logon attempts from the same
// source IP within a short time window, followed by a successful logon.
// This pattern is characteristic of password spraying or brute force
// attacks against RDP, RD Gateway, or Azure AD-joined Windows machines.
//
// False Positives:
// - Terminal Server / Citrix gateways (multi-user NAT)
// - Load balancer health probes (regular intervals, synthetic accounts)
// - Aggressive password expiration notifications (user retries)
//
// Recommended Response:
// 1. Verify the source IP reputation (AbuseIPDB, VirusTotal)
// 2. Check if the user who eventually succeeded is compromised
// 3. Conditional Access: Block sign-ins from this IP
// 4. If on-prem: review RD Gateway logs, block IP at firewall
// === QUERY ===

let time_window = 5m;
let failure_threshold = 10;
let success_after_failure = 5;
let lookback = 2h;

// Phase 1: Filter SigninLogs to RDP-related events (materialized to fix
// Kusto scoping issue with let + join)
let rdp_signins = materialize(
    SigninLogs
    | where TimeGenerated > ago(lookback)
    | where ResultType in ("0", "50053", "50057", "50126")
    | where AppDisplayName has_any ("RD", "Remote", "RDP", "Terminal", "Gateway")
        or UserAgent has_any ("Microsoft Terminal Services", "RDP", "MSRDP")
);

// Phase 2: Aggregate failed logons per IP
let failed_logons =
    rdp_signins
    | where ResultType != "0"
    | summarize
        FailureCount = count(),
        UsersTargeted = make_set(UserPrincipalName),
        FirstAttempt = min(TimeGenerated),
        LastAttempt = max(TimeGenerated)
        by IPAddress
    | where FailureCount >= failure_threshold;

// Phase 3: Aggregate successful logons per IP
let successful_logons =
    rdp_signins
    | where ResultType == "0"
    | summarize
        SuccessCount = count(),
        UsersSuccessful = make_set(UserPrincipalName),
        FirstSuccess = min(TimeGenerated)
        by IPAddress;

// Phase 4: Join — find IPs that had failures THEN success
failed_logons
| join kind=inner successful_logons on IPAddress
| where
    FirstSuccess between (FirstAttempt .. (LastAttempt + time_window))
    and SuccessCount <= success_after_failure
| project
    TimeGenerated = LastAttempt,
    SourceIP = IPAddress,
    FailureCount,
    SuccessCount,
    UsersTargeted,
    UsersSuccessful,
    FirstAttempt,
    LastAttempt,
    FirstSuccess
| extend
    AlertName = "Brute Force RDP Detection",
    Severity = "High",
    TechniqueId = "T1110",
    TechniqueName = "Brute Force",
    Description = strcat(
        "Source IP ", SourceIP, " performed ", FailureCount,
        " failed RDP logons targeting ", array_length(UsersTargeted),
        " user(s) within ", datetime_diff('minute', LastAttempt, FirstAttempt),
        " minutes, followed by ", SuccessCount, " successful logon(s)."
    )
| sort by FailureCount desc