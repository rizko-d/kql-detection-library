// === MITRE ATT&CK ===
// Technique: T1021.003 — Remote Services: Distributed Component Object Model
// Tactic: Lateral Movement
// Severity: High
// Data Source: DeviceProcessEvents (Microsoft Defender for Endpoint)
//
// Detects: Lateral movement via DCOM, where an attacker instantiates a remote
// COM object (MMC20.Application, ShellWindows, ShellBrowserWindow, Excel.Application,
// Outlook, Visio) on a target host to execute commands. The victim host shows a
// DCOM-related service process (mmc.exe, excel.exe, explorer.exe) spawning an
// unexpected child such as cmd.exe or powershell.exe.
//
// Key indicators:
// - PowerShell using [activator]::CreateInstance([type]::GetTypeFromProgID(...))
//   with -ComputerName (client side)
// - MMC20.Application.Document.ActiveView.ExecuteShellCommand
// - Office apps (excel.exe, outlook.exe, winword.exe) or mmc.exe spawning
//   cmd.exe / powershell.exe / script hosts on the destination
//
// False Positives:
// - Legitimate DCOM-based management or macro automation
// - Admins using MMC snap-ins that legitimately shell out
//
// Recommended Response:
// 1. Identify the DCOM server process and its unexpected child
// 2. On the client side, look for CreateInstance + GetTypeFromProgID + -ComputerName
// 3. Correlate source and destination hosts
// 4. Investigate what command was executed
// 5. Restrict DCOM permissions and monitor privileged COM ProgIDs
// === QUERY ===

let lookback = 1d;
let dcom_server_processes = dynamic([
    "mmc.exe", "excel.exe", "outlook.exe", "winword.exe", "powerpnt.exe",
    "visio.exe", "explorer.exe"
]);
let suspicious_children = dynamic([
    "cmd.exe", "powershell.exe", "pwsh.exe", "mshta.exe", "rundll32.exe",
    "regsvr32.exe", "wscript.exe", "cscript.exe", "certutil.exe", "bitsadmin.exe"
]);
let dcom_client_markers = dynamic([
    "GetTypeFromProgID", "GetTypeFromCLSID", "CreateInstance",
    "MMC20.Application", "ShellWindows", "ShellBrowserWindow",
    "ExecuteShellCommand", "Excel.Application", "9BA05972-F6A8-11CF-A442-00A0C90A8F39",
    "C08AFD90-F2A1-11D1-8455-00A0C91F3880"
]);

// Method 1: DCOM server process spawning a suspicious child (server side)
let dcom_child =
    DeviceProcessEvents
    | where TimeGenerated > ago(lookback)
    | where InitiatingProcessFileName in~ (dcom_server_processes)
    | where FileName in~ (suspicious_children)
    | project
        TimeGenerated,
        DeviceName,
        DetectionType = "DCOM server spawned suspicious child",
        DcomServer = InitiatingProcessFileName,
        ChildProcess = FileName,
        ProcessCommandLine,
        Account = AccountName;

// Method 2: PowerShell DCOM client invocation (client side)
let dcom_client =
    DeviceProcessEvents
    | where TimeGenerated > ago(lookback)
    | where FileName in~ ("powershell.exe", "pwsh.exe")
    | where ProcessCommandLine has_any (dcom_client_markers)
    | where ProcessCommandLine has_any ("-ComputerName", "GetTypeFromProgID", "GetTypeFromCLSID")
    | project
        TimeGenerated,
        DeviceName,
        DetectionType = "PowerShell DCOM remote instantiation",
        DcomServer = "",
        ChildProcess = "powershell.exe",
        ProcessCommandLine,
        Account = AccountName;

union dcom_child, dcom_client
| extend
    AlertName = "DCOM Lateral Movement",
    Severity = "High",
    TechniqueId = "T1021.003",
    TechniqueName = "Remote Services: Distributed Component Object Model",
    Description = strcat(
        "DCOM lateral movement indicator (", DetectionType, ") on '",
        DeviceName, "' by '", Account, "'. ",
        iff(DcomServer != "", strcat("Server: ", DcomServer, " -> ", ChildProcess, "."), "Client-side DCOM instantiation.")
    )
| project
    TimeGenerated, DeviceName, DetectionType, DcomServer, ChildProcess,
    ProcessCommandLine, Account,
    AlertName, Severity, TechniqueId, TechniqueName, Description
| sort by TimeGenerated desc