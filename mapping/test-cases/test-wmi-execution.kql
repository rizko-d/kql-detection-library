// === Test Case: WMI Execution / Lateral Movement ===
// Simulates: wmic remote process create (/node:) + PowerShell Invoke-WmiMethod
// remote + WmiPrvSE spawning powershell (malicious) + local wmic query benign.
// Expected: 3 alerts (2 high remote, 1 from WmiPrvSE child).
// Query expects: DeviceProcessEvents (Microsoft Defender for Endpoint)

let TestDeviceProcessEvents = datatable(
    TimeGenerated: datetime,
    FileName: string,
    ProcessCommandLine: string,
    AccountName: string,
    InitiatingProcessFileName: string,
    DeviceName: string
)
[
    // Malicious: wmic remote process create
    datetime(2025-07-26 22:00:00), "wmic.exe",
    "wmic.exe /node:10.10.50.30 process call create \"powershell -enc SQBFAFgA\"",
    "attacker_admin", "cmd.exe", "WS-001",
    // Malicious: PowerShell Invoke-WmiMethod remote
    datetime(2025-07-26 22:05:00), "powershell.exe",
    "powershell.exe Invoke-WmiMethod -Class Win32_Process -Name Create -ArgumentList 'cmd /c payload.exe' -ComputerName SRV-DB01",
    "akim", "explorer.exe", "WS-002",
    // Malicious: WmiPrvSE spawning powershell (remote WMI exec landed)
    datetime(2025-07-26 22:06:00), "powershell.exe",
    "powershell.exe -enc SQBFAFgA",
    "SYSTEM", "WmiPrvSE.exe", "SRV-DB01",
    // Benign: local wmic query (should NOT fire — no process call create)
    datetime(2025-07-26 23:00:00), "wmic.exe",
    "wmic.exe process list brief",
    "analyst", "cmd.exe", "WS-003",
];

TestDeviceProcessEvents