    datetime(2025-07-26 12:05:00), "ConnectionSuccess", "Public", "185.100.50.10", "hxxp://c2", 443, "svchost.exe", "WS-001",
    datetime(2025-07-26 12:06:00), "ConnectionSuccess", "Public", "185.100.50.10", "hxxp://c2", 443, "svchost.exe", "WS-001",
    datetime(2025-07-26 12:07:00), "ConnectionSuccess", "Public", "185.100.50.10", "hxxp://c2", 443, "svchost.exe", "WS-001",
    datetime(2025-07-26 12:08:00), "ConnectionSuccess", "Public", "185.100.50.10", "hxxp://c2", 443, "svchost.exe", "WS-001",
    datetime(2025-07-26 12:09:00), "ConnectionSuccess", "Public", "185.100.50.10", "hxxp://c2", 443, "svchost.exe", "WS-001",
