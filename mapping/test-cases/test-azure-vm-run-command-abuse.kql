    TimeGenerated: datetime,
    OperationNameValue: string,
    Caller: string,
    HTTPRequest: string,
    Resource: string,
    ResourceGroup: string
)
[
    // Malicious: Run Command across 4 VMs
    datetime(2025-07-26 12:00:00), "Microsoft.Compute/virtualMachines/runCommand/action", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "VM-PROD-01", "prod-rg",
    datetime(2025-07-26 12:01:00), "Microsoft.Compute/virtualMachines/runCommand/action", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "VM-PROD-02", "prod-rg",
    datetime(2025-07-26 12:02:00), "Microsoft.Compute/virtualMachines/runCommand/action", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "VM-PROD-03", "prod-rg",
    datetime(2025-07-26 12:03:00), "Microsoft.Compute/virtualMachines/runCommand/action", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "VM-PROD-04", "prod-rg",
