    datetime(2025-07-26 12:01:30), "Microsoft.Storage/storageAccounts/delete", "Succeeded", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "prodstorage",
    datetime(2025-07-26 12:02:00), "Microsoft.Network/networkSecurityGroups/delete", "Succeeded", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "prod-nsg",
