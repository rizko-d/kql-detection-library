    TimeGenerated: datetime,
    OperationNameValue: string,
    ActivityStatusValue: string,
    Caller: string,
    HTTPRequest: string,
    Resource: string
)
[
    // Malicious: destructive burst
    datetime(2025-07-26 12:00:00), "Microsoft.Resources/subscriptions/resourceGroups/delete", "Succeeded", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "prod-rg",
    datetime(2025-07-26 12:00:30), "Microsoft.RecoveryServices/vaults/delete", "Succeeded", "attacker@contoso.com", "{\"clientIpAddress\":\"185.220.101.50\"}", "prod-backup-vault",
