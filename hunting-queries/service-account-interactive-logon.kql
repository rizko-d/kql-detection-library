// === HUNT ===
// Technique: T1078 — Valid Accounts (Service Account Interactive Logon)
// Tactic: Persistence / Privilege Escalation
// Hunt Hypothesis: Service accounts should authenticate non-interactively
//   (types 3/4/5). An interactive (type 2) or RemoteInteractive (type 10) logon
//   by a service account strongly suggests credential theft and hands-on-keyboard
//   abuse of that account.
// Data Source: SecurityEvent (4624), SigninLogs
// Investigation Steps:
//   1. Identify service accounts (naming convention: svc-, svc_, $-suffixed, or a
//      maintained watchlist) with interactive/RemoteInteractive logons
//   2. Confirm the account is truly a service account (not a person)
//   3. Determine the source host and what ran under the session
//   4. Treat any confirmed interactive service-account logon as high priority
// Pivots:
//   - Pivot on the account -> all hosts it authenticated to
//   - Pivot on the source host -> other suspicious activity
//   - Correlate with the account's normal (non-interactive) logon pattern
// === QUERY ===

let lookback = 7d;
// Adjust these markers to your service-account naming convention / watchlist
let svc_prefixes = dynamic(["svc-", "svc_", "service-", "sa-", "srv-", "app-"]);
let interactive_types = dynamic([2, 10]);   // Interactive, RemoteInteractive

SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4624
| where LogonType in (interactive_types)
| extend AccountLower = tolower(TargetUserName)
| where AccountLower has_any (svc_prefixes)
| where TargetUserName !endswith "$"
| summarize
    LogonCount = count(),
    Hosts = make_set(Computer, 30),
    LogonTypes = make_set(LogonType),
    SourceIPs = make_set(IpAddress, 20),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by TargetUserName
| project
    TargetUserName, LogonCount, LogonTypes, Hosts, SourceIPs, FirstSeen, LastSeen
| sort by LogonCount desc